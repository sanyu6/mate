+
+template <class T, size_t N>
+constexpr mute::array<T,N> exchange_sort(mute::array<T,N> a) {
+  for (size_t i = 0; i < N; ++i) {
+    for (size_t j = i+1; j < N; ++j) {
+      if (a[j] < a[i]) {
+        T tmp = a[j]; a[j] = a[i]; a[i] = tmp;
+      }
+    }
+  }
+  return a;
+}
