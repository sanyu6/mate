+  return MP32::SQMMA::detail::op_selector_impl<true, ElementSF,
+                                               ElementA, ElementB, ElementC, TileShape_MNK,
+                                               MajorA, MajorB,
+                                               MaxInstructionM, MaxInstructionN, MaxInstructionKBytes,
+                                               scaleA, scaleB>();
+}
