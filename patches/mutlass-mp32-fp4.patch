+       int32_t const& dim4)
+  {
+    return MP32_TME_LOAD_5D<sg, ss, sl, inner_hint, outer_hint, prefetch, PermutationStride>::copy(desc_ptr, bar_id, smem_ptr, crd0, crd1, crd2, crd3, crd4, dim0, dim1, dim2, dim3, dim4);
+  }
+};
