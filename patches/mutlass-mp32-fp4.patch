+
+template <FpEncoding FpExMyCode> struct FpEncodingSelector {
+  using type = void;
+};
+
+template <> struct FpEncodingSelector<FpEncoding::E11M52> {
+  using type = mutlass::detail::FpBitRepresentation<uint64_t, 64, 11, 52, mutlass::detail::NanInfEncoding::IEEE_754>;
+};
+
+template <> struct FpEncodingSelector<FpEncoding::E8M23> {
+  using type = mutlass::detail::FpBitRepresentation<uint32_t, 32, 8, 23, mutlass::detail::NanInfEncoding::IEEE_754>;
+};
+template <> struct FpEncodingSelector<FpEncoding::E5M2> {
+  using type = mutlass::detail::FpBitRepresentation<uint8_t, 8, 5, 2, mutlass::detail::NanInfEncoding::IEEE_754>;
+};
+
+template <> struct FpEncodingSelector<FpEncoding::E4M3> {
+  using type = mutlass::detail::FpBitRepresentation<uint8_t, 8, 4, 3, mutlass::detail::NanInfEncoding::CANONICAL_ONLY>;
+};
+
+template <> struct FpEncodingSelector<FpEncoding::UE4M3> {
+  using type = mutlass::detail::FpBitRepresentation<uint8_t, 8, 4, 3, mutlass::detail::NanInfEncoding::CANONICAL_ONLY, false>;
