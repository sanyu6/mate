-  /// Inequality
-  MUTE_HOST_DEVICE constexpr
-  bool operator!=(integer_subbyte const& rhs) const {
-    return storage != rhs.storage;
-  }
-
-  /// Less than or equal
-  MUTE_HOST_DEVICE constexpr
-  bool operator<=(integer_subbyte const& rhs) const {
-    if (sign_mask_ & storage) {
-      return !(rhs.storage < storage);
-    } else {
-      return storage <= rhs.storage;
-    }
-  }
-
-  /// Less than
-  MUTE_HOST_DEVICE constexpr
-  bool operator<(integer_subbyte const& rhs) const {
