+    , phase_(phase)
+    , count_(count) {}
+
+  MUTLASS_DEVICE
+  int index() const {
+    return index_;
+  }
+
+  MUTLASS_DEVICE
+  uint32_t phase() const {
+    return phase_;
+  }
+
+  MUTLASS_DEVICE
