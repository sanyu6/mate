#include <musa_runtime.h>

#include <cstddef>
#include <cstdint>
#include <limits>

#include "mate/gemm/deep_gemm/mp32_mqa_logits_blockscale_metadata.hpp"
#include "op_utils.hpp"

void {{ func_name }}(ffi::TensorView cu_seq_len_k_start,
                     ffi::TensorView cu_seq_len_k_end,
                     int64_t         num_kv_tokens,
                     ffi::TensorView schedule_meta) {
  CHECK_MUSA(cu_seq_len_k_start);
  CHECK_MUSA(cu_seq_len_k_end);
  CHECK_MUSA(schedule_meta);
  CHECK_CONTIGUOUS(cu_seq_len_k_start);
  CHECK_CONTIGUOUS(cu_seq_len_k_end);
  CHECK_CONTIGUOUS(schedule_meta);
  CHECK_INPUT_TYPE(cu_seq_len_k_start, dl_int32);
  CHECK_INPUT_TYPE(cu_seq_len_k_end, dl_int32);
  CHECK_INPUT_TYPE(schedule_meta, dl_int32);
  CHECK_DEVICE(cu_seq_len_k_end, cu_seq_len_k_start);
  CHECK_DEVICE(schedule_meta, cu_seq_len_k_start);

  constexpr uint32_t kTileQ  = {{ tile_q }};
  constexpr uint32_t kTileKV = {{ tile_kv }};
  constexpr uint32_t kNumMPs = {{ num_mps }};

  CHECK_DIM(1, cu_seq_len_k_start);
  CHECK_DIM(1, cu_seq_len_k_end);
  CHECK_DIM(1, schedule_meta);
  TVM_FFI_ICHECK(cu_seq_len_k_start.size(0) == cu_seq_len_k_end.size(0))
      << "cu_seq_len_k_start and cu_seq_len_k_end must have the same length";
  TVM_FFI_ICHECK(cu_seq_len_k_start.size(0) > 0) << "cu_seq_len_k_start must contain at least one row";
  TVM_FFI_ICHECK(num_kv_tokens > 0) << "num_kv_tokens must be positive";

  auto          ceil_div     = [](int64_t a, int64_t b) -> int64_t { return (a + b - 1) / b; };
  int64_t const num_q_tokens = cu_seq_len_k_start.size(0);
  int64_t const num_q_tiles  = ceil_div(num_q_tokens, int64_t(kTileQ));

  constexpr int64_t kMaxNumQBlocksLog2 = 15;
  TVM_FFI_ICHECK(num_q_tiles <= (int64_t(1) << kMaxNumQBlocksLog2))
      << "num_q_tiles exceeds the prefix search bound";

  int64_t const total_work_bound = num_q_tiles * ceil_div(num_kv_tokens, int64_t(kTileKV));
  int64_t const total_cost_bound = total_work_bound + num_q_tiles;
  TVM_FFI_ICHECK(total_work_bound <= std::numeric_limits<uint32_t>::max())
      << "total_work_bound exceeds uint32";
  TVM_FFI_ICHECK(total_cost_bound <= std::numeric_limits<uint32_t>::max())
      << "total_cost_bound exceeds uint32";

  int64_t const required_words =
      int64_t(mate::deep_gemm::mqa_logits_meta_span_word_offset(kNumMPs)) + 2 * num_q_tiles;
  TVM_FFI_ICHECK(schedule_meta.size(0) >= required_words) << "schedule_meta is too small";

  auto const* ks_ptr   = static_cast<uint32_t const*>(cu_seq_len_k_start.data_ptr());
  auto const* ke_ptr   = static_cast<uint32_t const*>(cu_seq_len_k_end.data_ptr());
  auto*       meta_ptr = static_cast<uint32_t*>(schedule_meta.data_ptr());

  musaDeviceProp dprops{};
  MATE_MUSA_RUNTIME_CHECK(musaGetDeviceProperties(&dprops, cu_seq_len_k_start.device().device_id));

  size_t const smem_size = size_t(2 * num_q_tiles) * sizeof(uint32_t);
  TVM_FFI_ICHECK(smem_size <= dprops.sharedMemPerBlockOptin) << "smem_size exceeds the device limit";

  ffi::MUSADeviceGuard device_guard(cu_seq_len_k_start.device().device_id);
  musaStream_t         stream = get_stream(cu_seq_len_k_start.device());

  constexpr uint32_t kNumThreads = 256;
  auto kernel = mate::deep_gemm::mp32_mqa_logits_blockscale_metadata<kTileQ, kTileKV, kNumMPs>;
  MATE_MUSA_RUNTIME_CHECK(
      musaFuncSetAttribute(kernel, musaFuncAttributeMaxDynamicSharedMemorySize, static_cast<int>(smem_size)));
  kernel<<<1, kNumThreads, smem_size, stream>>>(static_cast<uint32_t>(num_q_tokens),
                                                static_cast<uint32_t>(num_kv_tokens), ks_ptr, ke_ptr, meta_ptr);
  MATE_MUSA_RUNTIME_CHECK(musaGetLastError());
}
